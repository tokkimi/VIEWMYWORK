# Neon Postgres (required for persistent client rooms and integrations)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Resend (required for client invitation emails)
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=VIEWMYWORK <hello@yourdomain.com>

# Google OAuth. Add http://localhost:3000/api/integrations/google/callback
# and your production callback to Google Cloud Console.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# Used to encrypt OAuth refresh tokens before persistence.
INTEGRATION_ENCRYPTION_KEY=replace-with-a-32-byte-secret
