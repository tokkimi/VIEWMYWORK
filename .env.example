# ─── Required ───
DATABASE_URL="postgresql://user:pass@host:5432/viewmywork?sslmode=require"   # pooled URL (e.g. Neon pooler)
DATABASE_URL_UNPOOLED="postgresql://user:pass@host:5432/viewmywork?sslmode=require"     # direct URL for migrations (optional)
APP_URL="https://your-domain.com"
ENCRYPTION_KEY="random 32+ char secret"        # encrypts integration tokens, signs OAuth state
CRON_SECRET="random secret"                    # Vercel Cron sends it as Bearer token
SUPER_ADMIN_EMAIL="you@example.com"            # this account becomes Platform Super Admin

# ─── Email (Resend) — without it, emails are logged as NOT_CONFIGURED and accounts are auto-verified ───
RESEND_API_KEY=""
EMAIL_FROM="FollowMyFuture <notifications@your-domain.com>"

# ─── Stripe (platform subscriptions + Stripe Connect for client invoice payments) ───
STRIPE_SECRET_KEY=""
STRIPE_PLATFORM_WEBHOOK_SECRET=""   # endpoint: /api/webhooks/stripe/platform (account events)
STRIPE_CONNECT_WEBHOOK_SECRET=""    # endpoint: /api/webhooks/stripe/connect (connected-account events)
PLATFORM_FEE_BPS="0"                # optional application fee on client payments (basis points)

# ─── S3-compatible storage (AWS S3, Cloudflare R2, …) ───
S3_ENDPOINT=""          # empty for AWS; e.g. https://<account>.r2.cloudflarestorage.com
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─── Google Drive (optional) ───
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
